---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import QuickAnswer from "../../components/QuickAnswer.astro";
import AdSlot from "../../components/AdSlot.astro";
import { siteConfig } from "../../config/site.config";

export async function getStaticPaths() {
  const pages = await getCollection("codes", ({ data }) => !data.draft);
  return pages.map((page) => ({
    params: { slug: page.id },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const { data } = page;
const active = data.codes.filter((c) => c.status === "active");
const expired = data.codes.filter((c) => c.status === "expired");

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: data.title,
    description: data.description,
    dateModified: data.updated.toISOString(),
    author: { '@type': 'Organization', name: siteConfig.siteName },
  },
];
---
<BaseLayout title={data.title} description={data.description} canonical={`/codes/${page.id}/`} jsonLd={jsonLd}>
  <article>
    <h1>{data.title}</h1>
    <p>Last updated: <time datetime={data.updated.toISOString()}>{data.updated.toISOString().slice(0, 10)}</time></p>
    <QuickAnswer summary={data.summary} />

    {/* ── 广告位 1/3：300x250（2026-10-09 P0 补齐零位页，第二屏）── */}
    <div class="ad-bottom-row">
      <AdSlot zone="banner-300x250" label="Sponsored Field Intel" />
    </div>

    <Content />
    <h2>Active codes ({active.length})</h2>
    <table>
      <thead><tr><th>Code</th><th>Reward</th><th>Source</th></tr></thead>
      <tbody>
        {active.map((c) => (
          <tr>
            <td><code>{c.code}</code></td>
            <td>{c.reward}</td>
            <td><a href={c.sourceUrl} rel="noopener">source</a></td>
          </tr>
        ))}
      </tbody>
    </table>
    {expired.length > 0 && <h2>Expired codes (kept for reference)</h2>}
    <ul>
      {expired.map((c) => (<li><code>{c.code}</code> — {c.reward}</li>))}
    </ul>

    {/* ── 广告位 2/3 与 3/3：页尾横幅（桌面 728x90 / 移动 320x50，异 Key）── */}
    <div class="ad-bottom-row">
      <div class="ad-desktop-only">
        <AdSlot zone="banner-728x90" label="Sponsored Archive Intel" />
      </div>
      <div class="ad-mobile-only">
        <AdSlot zone="banner-320x50" label="Sponsored Archive Intel" />
      </div>
    </div>
  </article>
</BaseLayout>
