---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../config/site.config";
import AdSlot from "../../components/AdSlot.astro";

const codes = await getCollection("codes", ({ data }) => !data.draft);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${siteConfig.gameName} Promo Codes & Redemption Ledger`,
    description: `Official directory of verified promo codes, gift links, and reward ledgers for ${siteConfig.gameName}.`,
    url: `${siteConfig.siteUrl}/codes/`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.siteUrl },
      { '@type': 'ListItem', position: 2, name: 'Promo Codes', item: `${siteConfig.siteUrl}/codes/` },
    ],
  },
];
---
<BaseLayout
  title="Hellraiser Revival Codes & Locker Codes (Oct 2026)"
  description="All verified Hellraiser Revival codes for October 2026: reward entitlements, Deluxe bonuses and the 80s VHS filter. How redemption works on Steam and PS."
  canonical="/codes/"
  jsonLd={jsonLd}
>
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumbs">
      <a href="/">Home</a>
      <span class="separator">/</span>
      <span class="current">Promo Codes</span>
    </nav>

    <div class="section-header" style="margin-top: 16px;">
      <h1>Hellraiser Revival Codes & Rewards</h1>
      <p>Direct tracking of verified developer gifts, event drops, and redemption features. We actively audit community channels to filter out fake generators and expired codes.</p>
    </div>

    {/* ── 广告位 1/3：300x250（2026-10-09 P0 补齐零位页，第二屏）── */}
    <div class="ad-bottom-row">
      <AdSlot zone="banner-300x250" label="Sponsored Field Intel" />
    </div>

    <div class="cards-grid">
      {codes.map((c) => (
        <article class="guide-card" style="grid-column: 1 / -1; max-width: 680px;">
          <div class="card-body">
            <h2><a href={`/codes/${c.id}/`} style="color: inherit; text-decoration: none; font-size: 1.2rem; font-weight: 700;">{c.data.title}</a></h2>
            <p>{c.data.summary ?? 'Active codes and redemption status'}</p>
            <div class="card-footer">
              <time datetime={c.data.updated.toISOString()}>Updated: {c.data.updated.toISOString().slice(0, 10)}</time>
              <span>View Code Ledger →</span>
            </div>
          </div>
        </article>
      ))}
      {codes.length === 0 && (
        <p style="color: var(--muted);">No active promo codes at this time.</p>
      )}
    </div>

    {/* ── 广告位 2/3 与 3/3：页尾横幅（桌面 728x90 / 移动 320x50，异 Key）── */}
    <div class="ad-bottom-row">
      <div class="ad-desktop-only">
        <AdSlot zone="banner-728x90" label="Sponsored Archive Intel" />
      </div>
      <div class="ad-mobile-only">
        <AdSlot zone="banner-320x50" label="Sponsored Archive Intel" />
      </div>
    </div>
  </div>
</BaseLayout>
