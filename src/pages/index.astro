---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import VideoEmbed from "../components/VideoEmbed.astro";
import AdSlot from "../components/AdSlot.astro";
import { siteConfig } from "../config/site.config";

const guides = (await getCollection("guides", ({ data }) => !data.draft))
  .sort((a, b) => (b.data.updated?.valueOf() ?? b.data.pubDate.valueOf()) - (a.data.updated?.valueOf() ?? a.data.pubDate.valueOf()));
const latestUpdates = [...guides]
  .sort((a, b) => {
    const timeA = (a.data.updated ?? a.data.pubDate).valueOf();
    const timeB = (b.data.updated ?? b.data.pubDate).valueOf();
    return timeB - timeA;
  })
  .slice(0, 5);
const codes = await getCollection("codes", ({ data }) => !data.draft);
const activeCodesCount = codes.flatMap((c) => c.data.codes.filter((item) => item.status === "active")).length;

const walkthroughGuides = guides.filter((g) =>
  ['demo-walkthrough-secrets', 'how-to-save-sunny-endings-guide'].includes(g.id)
);
const bossGuides = guides.filter((g) =>
  ['bruno-keller-boss-guide', 'all-cenobites-weaknesses-guide'].includes(g.id)
);
const systemGuides = guides.filter((g) =>
  ['genesis-configuration-puzzle-guide', 'weapons-tier-list-durability'].includes(g.id)
);
const referenceGuides = guides.filter((g) =>
  [
    'system-requirements-pc-specs',
    'is-it-multiplayer-coop-faq',
    'censorship-usk-regional-differences',
    'collectors-edition-contents-guide',
  ].includes(g.id)
);

const cardImageMap: Record<string, string> = {
  "system-requirements-pc-specs": "/images/cards/ss_card_0.webp",
  "is-it-multiplayer-coop-faq": "/images/cards/ss_card_1.webp",
  "genesis-configuration-puzzle-guide": "/images/cards/ss_card_2.webp",
  "bruno-keller-boss-guide": "/images/cards/ss_card_3.webp",
  "how-to-save-sunny-endings-guide": "/images/cards/ss_card_4.webp",
  "demo-walkthrough-secrets": "/images/cards/ss_card_5.webp",
  "all-cenobites-weaknesses-guide": "/images/cards/ss_card_6.webp",
  "weapons-tier-list-durability": "/images/cards/ss_card_7.webp",
  "censorship-usk-regional-differences": "/images/cards/ss_card_8.webp",
  "collectors-edition-contents-guide": "/images/cards/ss_card_9.webp",
};

const firstGuideSlug = "demo-walkthrough-secrets";
---
<BaseLayout
  title="Hellraiser Revival Wiki — Demo, Bosses & PC Specs"
  description="Verified Hellraiser: Revival wiki: October 8, 2026 release, demo walkthrough, Cenobite boss guides, puzzle box solutions, PC specs and active codes."
>
  <!-- Full-bleed Cinematic Hero Section with Broad Atmospheric Backdrop & Wiki Explore Rail -->
  <section class="hero-wrapper">
    <div class="hero-backdrop">
      <img
        src="/images/screenshots/ss_0.jpg"
        alt={`${siteConfig.gameName} Scarlet Church Altar & Crypt Atmosphere`}
        class="hero-backdrop-img"
        loading="eager"
      />
      <div class="hero-backdrop-vignette"></div>
    </div>

    <div class="hero-overlay">
      <div class="hero-layout-grid">
        <!-- Hero 主引导区 -->
        <div class="hero-center">
          <div class="badge-row">
            <span class="badge gold">Tactical Database</span>
            <span class="badge">Evidence-Led Wiki</span>
            <span class="badge">{siteConfig.gameName}</span>
          </div>
          <h1>{siteConfig.gameName} <span class="brand-highlight">WIKI</span></h1>
          <p>The definitive evidence-led encyclopedia for <strong>{siteConfig.gameName}</strong>: master the Scarlet Church infiltration, solve the Genesis Configuration puzzle box, evade the Order of the Gash, and verify official PC hardware specs.</p>
          
          <div class="hero-cta-group">
            <a href={`/guide/${firstGuideSlug}/`} class="btn btn-primary">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M6 6h10"/><path d="M6 10h10"/></svg>
              <span>Explore All Guides →</span>
            </a>
            <a href="/tools/puzzle-simulator/" class="btn btn-secondary" style="border-color: rgba(212, 163, 115, 0.4); background: rgba(212, 163, 115, 0.1);">
              <span>⚡ Box Simulator</span>
            </a>
            <a href="https://store.steampowered.com/app/1551980" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
              <span>Wishlist on Steam</span>
            </a>
            <button type="button" class="btn btn-secondary search-trigger-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
              <span>Search Database</span>
              <kbd>⌘K</kbd>
            </button>
          </div>

          <!-- 核心情报横幅 (Pre-Launch Confirmed Intel) -->
          <div class="intel-banner">
            <div class="intel-banner-header">
              <span class="intel-banner-title">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                <span>Pre-Launch Confirmed Intel</span>
              </span>
              <span class="intel-banner-source">Direct from Saber Interactive / Steam</span>
            </div>
            <div class="intel-grid">
              <div class="intel-card">
                <div class="intel-label">Release Window</div>
                <div class="intel-val">October 8, 2026</div>
              </div>
              <div class="intel-card">
                <div class="intel-label">Platforms</div>
                <div class="intel-val">PC · PS5 · XSX · Switch 2</div>
              </div>
              <div class="intel-card">
                <div class="intel-label">Age Rating</div>
                <div class="intel-val">USK 18 (Uncut) / PEGI 18</div>
              </div>
              <div class="intel-card">
                <div class="intel-label">Multiplayer Mode</div>
                <div class="intel-val">100% Single-Player Horror</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Hero 右侧快捷频道导览轨 (Explore The Wiki Rail - Collapsible Accordion Hubs) -->
        <aside class="hero-rail" aria-label="Explore the wiki silos">
          <p class="hero-rail-title">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
            <span>Explore The Wiki</span>
          </p>
          <nav class="hero-rail-nav">
            <!-- Silo 1: Walkthrough -->
            <details class="hero-rail-details" open>
              <summary class="hero-rail-summary">
                <span class="rail-summary-label">
                  <span class="rail-toggle-arrow">▶</span>
                  <span>Walkthrough</span>
                </span>
                <span class="rail-count">{walkthroughGuides.length}</span>
              </summary>
              <ul class="hero-rail-sublinks">
                <li><a href="#silos" class="silo-browse-all">Browse Field Dossiers ↓</a></li>
                {walkthroughGuides.map((g) => (
                  <li><a href={`/guide/${g.id}/`}>{g.data.title}</a></li>
                ))}
              </ul>
            </details>

            <!-- Silo 2: Bosses -->
            <details class="hero-rail-details">
              <summary class="hero-rail-summary">
                <span class="rail-summary-label">
                  <span class="rail-toggle-arrow">▶</span>
                  <span>Bosses & Cenobites</span>
                </span>
                <span class="rail-count">{bossGuides.length}</span>
              </summary>
              <ul class="hero-rail-sublinks">
                <li><a href="#silos" class="silo-browse-all">Browse Field Dossiers ↓</a></li>
                {bossGuides.map((g) => (
                  <li><a href={`/guide/${g.id}/`}>{g.data.title}</a></li>
                ))}
              </ul>
            </details>

            <!-- Silo 3: Systems -->
            <details class="hero-rail-details">
              <summary class="hero-rail-summary">
                <span class="rail-summary-label">
                  <span class="rail-toggle-arrow">▶</span>
                  <span>Combat & Puzzles</span>
                </span>
                <span class="rail-count">{systemGuides.length}</span>
              </summary>
              <ul class="hero-rail-sublinks">
                <li><a href="#silos" class="silo-browse-all">Browse Field Dossiers ↓</a></li>
                {systemGuides.map((g) => (
                  <li><a href={`/guide/${g.id}/`}>{g.data.title}</a></li>
                ))}
              </ul>
            </details>

            <!-- Silo 4: Reference -->
            <details class="hero-rail-details">
              <summary class="hero-rail-summary">
                <span class="rail-summary-label">
                  <span class="rail-toggle-arrow">▶</span>
                  <span>Technical & Specs</span>
                </span>
                <span class="rail-count">{referenceGuides.length}</span>
              </summary>
              <ul class="hero-rail-sublinks">
                <li><a href="#silos" class="silo-browse-all">Browse Field Dossiers ↓</a></li>
                {referenceGuides.map((g) => (
                  <li><a href={`/guide/${g.id}/`}>{g.data.title}</a></li>
                ))}
              </ul>
            </details>

            <!-- Silo 5: Codes -->
            <details class="hero-rail-details">
              <summary class="hero-rail-summary">
                <span class="rail-summary-label">
                  <span class="rail-toggle-arrow">▶</span>
                  <span>Active Codes</span>
                </span>
                <span class="rail-count">{activeCodesCount}</span>
              </summary>
              <ul class="hero-rail-sublinks">
                <li><a href="/codes/" class="silo-browse-all">Open Codes Ledger →</a></li>
                {codes.map((c) => (
                  <li><a href={`/codes/${c.id}/`}>{c.data.title}</a></li>
                ))}
              </ul>
            </details>

            <!-- Silo 6: FAQ Hub -->
            <details class="hero-rail-details">
              <summary class="hero-rail-summary">
                <span class="rail-summary-label">
                  <span class="rail-toggle-arrow">▶</span>
                  <span>FAQ Hub</span>
                </span>
                <span class="rail-count">6</span>
              </summary>
              <ul class="hero-rail-sublinks">
                <li><a href="#faq" class="silo-browse-all">View All 6 FAQs ↓</a></li>
              </ul>
            </details>
          </nav>
        </aside>
      </div>
    </div>
  </section>

  <div class="container home-page">
    <!-- Official Reveal Trailer Feature -->
    <section class="official-trailer-section" style="margin-top: 48px; margin-bottom: 24px;">
      <div class="section-header">
        <h2>Clive Barker's Hellraiser: Revival Official Gameplay Reveal Trailer</h2>
        <p>Watch the verified official gameplay trailer showcasing the Scarlet Church, Pinhead's summoning rite, and psychological survival horror mechanics.</p>
      </div>
      <div style="max-width: 860px; margin: 0 auto;">
        <VideoEmbed
          id="0rA40lqttO8"
          title="Clive Barker's Hellraiser: Revival - Official Gameplay Reveal Trailer"
          channel="GameSpot"
          channelTitle="GameSpot"
          uploadDate="2026-06-10"
          description="Official gameplay reveal trailer for Clive Barker's Hellraiser: Revival showcasing real-time combat, Genesis Configuration puzzle interactions, and the Order of the Gash."
        />
      </div>
    </section>

    <!-- Section: Explore Wiki Silos (3-Col Grid: 铺满居中 1180 容器，全部 10 篇 guide 矩阵) -->
    <section id="silos" class="wiki-silos-section" style="margin-top: 56px;">
      <div class="section-header">
        <h2>Explore Wiki Silos & Field Dossiers</h2>
        <p>Comprehensive tactical walkthroughs, Cenobite encounters, weapon analyses, and hardware benchmarks across the Hellraiser: Revival campaign.</p>
      </div>
      <div class="cards-grid-3">
        {guides.map((g) => (
          <article class="guide-card card-compact">
            <div class="card-media">
              <span class="card-silo-badge">{g.data.category || 'Guide'}</span>
              <img
                src={cardImageMap[g.id] ?? `/images/cards/ss_card_0.webp`}
                alt={g.data.title}
                width="800"
                height="500"
                loading="lazy"
              />
            </div>
            <div class="card-body">
              <h3><a href={`/guide/${g.id}/`}>{g.data.title}</a></h3>
              <p>{g.data.description}</p>
              <div class="card-footer">
                <time datetime={g.data.pubDate.toISOString()}>{g.data.pubDate.toISOString().slice(0, 10)}</time>
                <span>Read Dossier →</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    {/* ── 首页唯一广告位：728x90 ──
        放在 silos 导航区之后（非首屏上方），新站起步期只挂 1 位，避免低质内容判定。
        与文章页的 300x250 不同尺寸/Key，无去重冲突。 */}
    <div class="ad-bottom-row">
      <AdSlot zone="banner-728x90" label="Sponsored Field Intel" />
    </div>

    <!-- Category 5: Promo Codes & Rewards Ledger -->
    {codes.length > 0 && (
      <section id="codes" style="margin-top: 56px;">
        <div class="section-header">
          <h2>Hellraiser Revival Codes & Rewards Ledger</h2>
          <p>Active promo codes and redemption status verified directly from official developer channels.</p>
        </div>
        <div class="cards-grid-2">
          {codes.map((c) => (
            <article class="guide-card card-featured" style="grid-column: 1 / -1; max-width: 760px; margin: 0 auto; width: 100%;">
              <div class="card-body">
                <h3><a href={`/codes/${c.id}/`}>{c.data.title}</a></h3>
                <p>{c.data.summary}</p>
                <div class="card-footer">
                  <time datetime={c.data.updated.toISOString()}>Updated: {c.data.updated.toISOString().slice(0, 10)}</time>
                  <span>Check Code Ledger →</span>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- Category 6: Frequently Asked Questions -->
    <section id="faq" style="margin-top: 56px;">
      <div class="section-header">
        <h2>Hellraiser Revival Frequently Asked Questions</h2>
        <p>Direct, verified answers to the most common questions asked by players exploring the game.</p>
      </div>
      <div class="faq-grid">
        <div class="faq-card">
          <div class="faq-question">When is the official release date for Hellraiser: Revival?</div>
          <p class="faq-answer">Clive Barker's Hellraiser: Revival is scheduled for release on October 8, 2026, across PC (Steam), PlayStation 5, Xbox Series X|S, and Nintendo Switch 2.</p>
        </div>
        <div class="faq-card">
          <div class="faq-question">Does Hellraiser: Revival support multiplayer or online co-op?</div>
          <p class="faq-answer">No. The game is strictly a single-player narrative survival horror campaign. Developer Saber Interactive built the experience solely around solitary first-person psychological horror.</p>
        </div>
        <div class="faq-card">
          <div class="faq-question">Can you kill Cenobites like Pinhead, Chatterer, or Butterball?</div>
          <p class="faq-answer">No. Cenobites cannot be permanently eliminated with conventional firearms or melee weapons. Players must exploit sensory vulnerabilities, audio distractions, and puzzle box dimensional locks to evade them.</p>
        </div>
        <div class="faq-card">
          <div class="faq-question">What are the minimum PC hardware requirements?</div>
          <p class="faq-answer">Minimum specifications require Windows 10/11 64-bit, an AMD Ryzen 5 1500X or Intel Core i5-8400 CPU, 8 GB RAM, an NVIDIA GTX 1660 or AMD RX Vega 64 GPU, and 80 GB of SSD storage.</p>
        </div>
        <div class="faq-card">
          <div class="faq-question">Is Hellraiser: Revival censored in Germany or Europe?</div>
          <p class="faq-answer">No. The game has received an uncut USK 18 rating in Germany and PEGI 18 in Europe, retaining identical extreme gore, dismemberment, and torture sequences globally.</p>
        </div>
        <div class="faq-card">
          <div class="faq-question">What is the vestry safe code in the demo?</div>
          <p class="faq-answer">The safe code hidden behind the painting in the church vestry is 0-7-1-9, which yields shotgun ammunition and an emergency syringe.</p>
        </div>
      </div>
    </section>

    <!-- Section: Latest Updates (Freshness Ledger: 紧凑时序列表) -->
    <section id="updates" class="latest-updates-section">
      <div class="section-header">
        <div class="section-tag-row">
          <span class="live-dot pulse"></span>
          <span class="section-tag-text">FRESHNESS LEDGER</span>
        </div>
        <h2>Latest Field Updates & Guide Dossiers</h2>
        <p>Recently verified mechanics, walkthrough chapters, and hardware benchmarks across the campaign.</p>
      </div>
      <div class="updates-list">
        {latestUpdates.map((item) => (
          <a href={`/guide/${item.id}/`} class="update-row">
            <div class="update-row-left">
              <time class="update-date" datetime={(item.data.updated ?? item.data.pubDate).toISOString()}>
                {(item.data.updated ?? item.data.pubDate).toISOString().slice(0, 10)}
              </time>
              <span class="update-tag">{item.data.category || 'Guide'}</span>
              <span class="update-title">{item.data.title}</span>
            </div>
            <div class="update-row-right">
              <span class="update-meta">{Math.max(1, Math.round(item.body.split(/\s+/).length / 220))} min read</span>
              <span class="update-arrow">Read →</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Category 7: Ending Call to Action Banner -->
    <section class="cta-banner">
      <h2>Prepare to Enter the Labyrinth</h2>
      <p>Step into Clive Barker's uncompromised world of visceral terror. Track verified puzzle solutions, boss weaknesses, and game updates on Hellraiser Revival Wiki.</p>
      <div class="cta-actions">
        <a href="https://store.steampowered.com/app/1551980" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
          <span>Wishlist on Steam</span>
        </a>
        <a href="/guide/" class="btn btn-secondary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M6 6h10"/><path d="M6 10h10"/></svg>
          <span>Browse All Guides</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
