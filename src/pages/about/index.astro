---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../config/site.config";

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: `About ${siteConfig.siteName}`,
    description: `About the independent, evidence-led ${siteConfig.siteName} project: verified field notes and factual game mechanics.`,
    url: `${siteConfig.siteUrl}/about/`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.siteUrl },
      { '@type': 'ListItem', position: 2, name: 'About', item: `${siteConfig.siteUrl}/about/` },
    ],
  },
];
---
<BaseLayout
  title="About Hellraiser Revival Wiki: Editorial Mission"
  description="Learn about Hellraiser Revival Wiki: an independent, evidence-led encyclopedia built by survival horror fans with verified mechanics and zero speculation."
  canonical="/about/"
  jsonLd={jsonLd}
>
  <div class="container" style="max-width: var(--max); margin: 0 auto; padding: 2rem 1.5rem;">
    <article>
      <nav class="breadcrumbs" aria-label="Breadcrumbs" style="margin-bottom: 1.5rem; font-size: 0.85rem; color: var(--muted);">
        <a href="/" style="color: var(--muted);">Home</a>
        <span class="separator" style="margin: 0 0.5rem;">/</span>
        <span class="current" style="color: var(--ink);">About</span>
      </nav>

      <h1 style="font-family: var(--font-display); font-size: 2.2rem; margin-bottom: 0.5rem;">About Hellraiser Revival Wiki</h1>
      <div class="meta-bar" style="color: var(--muted); font-size: 0.9rem; margin-bottom: 2rem; border-bottom: 1px solid var(--line); padding-bottom: 1rem;">
        <span>Editorial Mission · Independent Survival Horror Encyclopedia</span>
      </div>

      <p>
        <strong>Hellraiser Revival Wiki</strong> (<a href={siteConfig.siteUrl}>{siteConfig.siteUrl}</a>) is an independent, community-driven database and strategy guide dedicated to <em>Clive Barker's Hellraiser: Revival</em>. Our goal is to provide verified puzzle solutions, weapon statistics, Cenobite encounter tactics, and objective game data without AI hallucinations or clickbait.
      </p>

      <h2 style="font-family: var(--font-display); font-size: 1.5rem; margin-top: 2rem;">Our Fact-Checking Standards</h2>
      <p>
        In modern gaming communities, guides are frequently polluted by speculative rumors and low-quality summaries. Hellraiser Revival Wiki strictly adheres to a three-tier evidence verification model:
      </p>
      <ul>
        <li><strong>Official Developer Disclosures</strong>: Verified announcements and patch logs published directly by Saber Interactive on Steam and official channels.</li>
        <li><strong>In-Game Tested Data</strong>: First-hand gameplay validation conducted within public builds, demos, and launch versions.</li>
        <li><strong>Strict TBA Boundaries</strong>: Unreleased lore, hidden items, or unconfirmed mechanics are strictly tagged as TBA rather than fabricated.</li>
      </ul>

      <h2 style="font-family: var(--font-display); font-size: 1.5rem; margin-top: 2rem;">Editorial Independence & Legal Disclaimer</h2>
      <p>
        This website is an independent enthusiast project. It is not affiliated with, endorsed by, or sponsored by Saber Interactive or Clive Barker. All game titles, trademarks, logos, character names (Pinhead, Cenobites), and in-game imagery are the property of their respective copyright owners.
      </p>

      <h2 style="font-family: var(--font-display); font-size: 1.5rem; margin-top: 2rem;">Contact & Feedback</h2>
      <p>
        Have verified puzzle findings, secret lock codes, or corrections to submit? Contact our editorial desk directly at <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a> or visit our <a href="/contact/">Contact Us page</a>.
      </p>
    </article>
  </div>
</BaseLayout>
